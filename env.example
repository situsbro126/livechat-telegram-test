# Required - Render Environment Variables
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-service.onrender.com
LIVECHAT_ACCESS_TOKEN=

# Recommended
# 2 detik = cepat tapi masih lebih aman daripada 1 detik untuk testing.
# Minimum kode: 1 detik. Jika LiveChat rate-limit, bridge backoff otomatis sampai 15 detik.
LIVECHAT_POLL_SECONDS=2
MAX_NEW_TOPICS_PER_POLL=3
BOOTSTRAP_SCAN_PAGES=5
