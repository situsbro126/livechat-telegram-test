# Required - Render Environment Variables
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-service.onrender.com
LIVECHAT_ACCESS_TOKEN=

# Recommended
LIVECHAT_POLL_SECONDS=2
MAX_NEW_TOPICS_PER_POLL=3
BOOTSTRAP_SCAN_PAGES=5

# Canned responses
# Recommended on Render: create Secret File named canned.json.
# Render mounts it at /etc/secrets/canned.json, which v2.5 detects automatically.
# Optional custom path:
# CANNED_FILE=/etc/secrets/canned.json

# Fallback only (not recommended for 67 responses):
# CANNED_RESPONSES_JSON={"hello":"Halo kak"}
