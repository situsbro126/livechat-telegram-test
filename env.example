PORT=8787
DEMO_MODE=true

# Telegram
TELEGRAM_BOT_TOKEN=
# numeric supergroup id, normally starts with -100
TELEGRAM_GROUP_ID=
# random secret, e.g. a long alphanumeric string
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS URL from Render/Railway/Cloudflare Tunnel/ngrok, no trailing slash
PUBLIC_BASE_URL=

# LiveChat.com - only needed when switching DEMO_MODE=false
LIVECHAT_ACCESS_TOKEN=
# Secret URL segment used by this test receiver
LIVECHAT_WEBHOOK_KEY=replace-with-a-long-random-string
